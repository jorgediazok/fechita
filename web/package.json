{
  "name": "fechita-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file=.env.local --import tsx scripts/seed-leagues.ts",
    "seed:clean": "node --env-file=.env.local --import tsx scripts/seed-leagues.ts --clean-only",
    "seed:bots": "node --env-file=.env.local --import tsx scripts/seed-bots.ts",
    "seed:e2e": "node --env-file=.env.local --import tsx scripts/seed-e2e.ts",
    "test:e2e": "npm run seed:e2e && playwright test",
    "test:e2e:ui": "npm run seed:e2e && playwright test --ui"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mongoose": "^9.9.5",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
