MONGODB_URI=

# De dónde salen los partidos:
#   mock         → fixtures simulados, sin red (default; habilita el panel dev de /pronosticos y /liga)
#   theoddsapi   → The Odds API, free tier, temporada argentina actual real
#   replay       → temporada real 2024 corrida al presente (bajar antes con `npm run fetch-season`)
#   thesportsdb  → TheSportsDB (el free tier limita las listas a 1 resultado — necesita key paga)
#   api-football → API-Football (de pago para la temporada en curso)
FIXTURE_SOURCE=mock

# Key de The Odds API (FIXTURE_SOURCE=theoddsapi). Gratis en https://the-odds-api.com/ — 500 créditos/mes.
THE_ODDS_API_KEY=

# Key de API-Football. La usa `npm run fetch-season` (modo replay) y el modo api-football.
# Sacada en dashboard.api-football.com. El free tier cubre temporadas 2022-2024.
API_FOOTBALL_KEY=

# Key de TheSportsDB (FIXTURE_SOURCE=thesportsdb). "123" es la key pública de prueba.
THESPORTSDB_KEY=123

# Secreto compartido para autorizar el endpoint de cron (/api/cron/sync).
CRON_SECRET=

# Secreto de NextAuth. Generar con: openssl rand -base64 32
AUTH_SECRET=

# OAuth Client ID de Google Cloud Console (tipo "Web application"), solo para el botón de Google.
# Redirect URI en dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL pública del sitio (metadata OG, sitemap, QR de la landing). En prod (Vercel) el dominio real,
# o se toma solo de VERCEL_PROJECT_PRODUCTION_URL. En dev, para probar el QR desde el celular,
# poné la IP de LAN de esta máquina (ej. http://192.168.1.50:3000) y entrá al celu a la misma wifi.
NEXT_PUBLIC_SITE_URL=
