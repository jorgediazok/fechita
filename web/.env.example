MONGODB_URI=

# De dónde salen los partidos (uno a la vez):
#   mock       → fixtures simulados, sin red (default; habilita el panel dev de /pronosticos y /liga)
#   theoddsapi → The Odds API, free tier, temporada argentina actual real (la que va a prod)
#   replay     → temporada real 2024 (JSON congelado en el repo) corrida al presente, sin red
FIXTURE_SOURCE=mock

# Key de The Odds API (solo si FIXTURE_SOURCE=theoddsapi). Gratis, sin tarjeta, en
# https://the-odds-api.com/ — 500 créditos/mes. mock y replay no necesitan ninguna key.
THE_ODDS_API_KEY=

# Secreto compartido para autorizar el endpoint de cron (/api/cron/sync).
CRON_SECRET=

# Secreto de NextAuth. Generar con: openssl rand -base64 32
AUTH_SECRET=

# Web push (notificaciones). Generar el par con: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY tiene que ser el mismo valor que VAPID_PUBLIC_KEY.
# VAPID_SUBJECT: un mailto: o URL de contacto. Sin estas vars, las notificaciones quedan desactivadas (la app funciona igual).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@fechita.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Verificación de email de las cuentas registradas por /signup (las de Google ya vienen
# verificadas). API key de Resend (resend.com, free tier sin tarjeta, "Sending access" alcanza).
# Sin esta var, sendEmail() es no-op — la app funciona igual, pero nadie recibe el mail.
RESEND_API_KEY=
# Remitente. El dominio de pruebas de Resend (onboarding@resend.dev, no necesita verificar
# nada) solo puede mandarle mail al dueño de la cuenta de Resend — a nadie más — hasta que se
# verifique un dominio propio con DNS. Cambiar cuando haya un dominio real.
EMAIL_FROM=Fechita <onboarding@resend.dev>
# "true" para EXIGIR el mail confirmado antes de pronosticar / crear-unirse a un grupo. En
# false (default) hasta tener un dominio propio verificado — en false, toda la costura de
# verificación queda armada pero no bloquea a nadie (ver src/lib/emailVerification.ts).
REQUIRE_EMAIL_VERIFICATION=false

# OAuth Client ID de Google Cloud Console (tipo "Web application"), solo para el botón de Google.
# Redirect URI en dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL pública del sitio (metadata OG, sitemap, QR de la landing). En prod (Vercel) el dominio real,
# o se toma solo de VERCEL_PROJECT_PRODUCTION_URL. En dev, para probar el QR desde el celular,
# poné la IP de LAN de esta máquina (ej. http://192.168.1.50:3000) y entrá al celu a la misma wifi.
NEXT_PUBLIC_SITE_URL=
